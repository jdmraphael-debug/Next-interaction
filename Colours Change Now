using UnityEngine;

[RequireComponent(typeof(MeshRenderer), typeof(Collider), typeof(Rigidbody))]
public class Shooter : MonoBehaviour
{
    private int _frameCounter;

    [SerializeField] private Transform myTransform;
    [SerializeField] private MeshRenderer meshRenderer;
    [SerializeField] private Rigidbody rb;

    void Start()
    {
        Debug.Log("Shooter script started!");

        if (myTransform == null)
            myTransform = transform;

        if (meshRenderer == null)
            meshRenderer = GetComponent<MeshRenderer>();

        if (rb == null)
            rb = GetComponent<Rigidbody>();

        // Disable gravity so the sphere doesn't fall down
        rb.useGravity = false;
        rb.isKinematic = true;

        // Set initial random color
        SetSphereColor(Random.ColorHSV(0f, 1f, 0.8f, 1f, 0.8f, 1f));
    }

    void FixedUpdate()
    { 
        _frameCounter++;
        if (_frameCounter % 60 == 0)
        {
            Debug.Log($"Physics step: {_frameCounter / 60}");
            
            // Move via Rigidbody so the physics collider updates position with the mesh
            rb.MovePosition(rb.position + Vector3.up);
        }
    } 

    private void OnMouseDown()
    {
        // Pick a brand new bright random color on every click
        Color randomColor = Random.ColorHSV(0f, 1f, 0.8f, 1f, 0.8f, 1f);
        SetSphereColor(randomColor);

        Debug.Log($"Clicked! New Random Color: {randomColor}");
    }

    private void SetSphereColor(Color color)
    {
        if (meshRenderer == null) return;

        Material mat = meshRenderer.material;
        mat.color = color;

        if (mat.HasProperty("_BaseColor"))
        {
            mat.SetColor("_BaseColor", color);
        }
    }
}
