using UnityEngine;

[RequireComponent(typeof(MeshRenderer), typeof(Collider), typeof(Rigidbody))]
public class Shooter : MonoBehaviour
{
    private Vector3 _originalScale;
    private float _pulseTimer;

    // Movement phases
    private enum MovementState { Falling, CircularOrbit, TransitionToCorner, CornerToCorner }
    private MovementState _currentState = MovementState.Falling;

    // Circular Orbit & Plane Corner variables
    private Vector3 _centerPosition;
    private float _angle;
    private Vector3[] _planeCorners;
    private int _currentCornerIndex;

    // Interpolation progress tracking
    private float _lerpProgress;
    private Vector3 _segmentStartPos;

    [Header("Movement Settings")]
    [SerializeField] private float hoverHeight = 0.5f;        // Height above ground
    [SerializeField] private float circleRadius = 1.5f;      // Radius of the 1-lap orbit
    [SerializeField] private float circleSpeed = 3.0f;       // Orbit rotation speed
    
    [Header("Corner Path Timing")]
    [Tooltip("Time in seconds to move from one corner to the next (e.g., 3.0s).")]
    [SerializeField] private float sideTravelTime = 3.0f;    // Set to 3 seconds per corner leg

    [Header("Component References")]
    [SerializeField] private Transform myTransform;
    [SerializeField] private MeshRenderer meshRenderer;
    [SerializeField] private Rigidbody rb;

    void Start()
    {
        Debug.Log("Shooter script started!");

        if (myTransform == null)
            myTransform = transform;

        if (meshRenderer == null)
            meshRenderer = GetComponent<MeshRenderer>();

        if (rb == null)
            rb = GetComponent<Rigidbody>();

        // Drop under physics gravity initially
        rb.useGravity = true;
        rb.isKinematic = false;

        _originalScale = myTransform.localScale;

        // Set initial random color
        SetSphereColor(GetRandomVibrantColor());
    }

    void Update()
    {
        // Smoothly animate scale pulse when clicked
        AnimatePulse();

        // Corner pathing uses percentages in Update() for smooth, consistent travel duration
        if (_currentState == MovementState.TransitionToCorner)
        {
            PerformTransitionToFirstCorner();
        }
        else if (_currentState == MovementState.CornerToCorner)
        {
            PerformCornerToCornerPath();
        }
    }

    void FixedUpdate()
    { 
        if (_currentState == MovementState.CircularOrbit)
        {
            PerformCircularOrbit();
        }
    } 

    private void PerformCircularOrbit()
    {
        _angle += circleSpeed * Time.fixedDeltaTime;

        // Check if 1 full 360-degree rotation (2 * PI radians) is complete
        if (_angle >= Mathf.PI * 2f)
        {
            _currentState = MovementState.TransitionToCorner;
            _currentCornerIndex = 0;
            _lerpProgress = 0f;
            _segmentStartPos = myTransform.position;

            Debug.Log("Completed initial circle! Heading to the first corner.");
            return;
        }

        // Circular movement around landing point
        float x = Mathf.Cos(_angle) * circleRadius;
        float z = Mathf.Sin(_angle) * circleRadius;

        Vector3 targetPos = _centerPosition + new Vector3(x, hoverHeight, z);
        rb.MovePosition(targetPos);
    }

    private void PerformTransitionToFirstCorner()
    {
        Vector3 firstCorner = _planeCorners[0];

        // Advance progress over 3 seconds
        _lerpProgress += Time.deltaTime / Mathf.Max(0.001f, sideTravelTime);
        myTransform.position = Vector3.Lerp(_segmentStartPos, firstCorner, _lerpProgress);

        if (_lerpProgress >= 1.0f)
        {
            _currentState = MovementState.CornerToCorner;
            _currentCornerIndex = 1; // Target second corner next
            _lerpProgress = 0f;
            _segmentStartPos = firstCorner;

            Debug.Log("Reached Corner 1! Beginning 3-second corner-to-corner loop.");
        }
    }

    private void PerformCornerToCornerPath()
    {
        if (_planeCorners == null || _planeCorners.Length == 0) return;

        Vector3 targetCorner = _planeCorners[_currentCornerIndex];

        // Advance progress over 3 seconds
        _lerpProgress += Time.deltaTime / Mathf.Max(0.001f, sideTravelTime);
        myTransform.position = Vector3.Lerp(_segmentStartPos, targetCorner, _lerpProgress);

        if (_lerpProgress >= 1.0f)
        {
            _segmentStartPos = targetCorner;
            _currentCornerIndex = (_currentCornerIndex + 1) % _planeCorners.Length;
            _lerpProgress = 0f;

            Debug.Log($"Reached Corner {_currentCornerIndex + 1}/4");
        }
    }

    // Detect collision with the floor/plane
    private void OnCollisionEnter(Collision collision)
    {
        if (_currentState == MovementState.Falling)
        {
            _currentState = MovementState.CircularOrbit;

            // Switch to kinematic mode to hover and orbit smoothly
            rb.useGravity = false;
            rb.isKinematic = true;

            // Store landing center point
            _centerPosition = rb.position;
            _angle = 0f;

            // Find the 4 corners of the plane
            CalculatePlaneCorners(collision.collider);

            Debug.Log("Landed on plane! Starting initial circle.");
        }
    }

    private void CalculatePlaneCorners(Collider planeCollider)
    {
        Bounds bounds = planeCollider.bounds;
        _planeCorners = new Vector3[4];

        float targetY = bounds.max.y + hoverHeight;

        // 4 corners of the plane in order around the perimeter
        _planeCorners[0] = new Vector3(bounds.min.x, targetY, bounds.min.z); // Corner 1: Back-Left
        _planeCorners[1] = new Vector3(bounds.max.x, targetY, bounds.min.z); // Corner 2: Back-Right
        _planeCorners[2] = new Vector3(bounds.max.x, targetY, bounds.max.z); // Corner 3: Front-Right
        _planeCorners[3] = new Vector3(bounds.min.x, targetY, bounds.max.z); // Corner 4: Front-Left
    }

    private void OnMouseDown()
    {
        // 1. Assign a new random color
        SetSphereColor(GetRandomVibrantColor());

        // 2. Trigger the pulse squish animation
        _pulseTimer = 1f;

        Debug.Log("Clicked! Sphere updated with new random color and pulse effect.");
    }

    private Color GetRandomVibrantColor()
    {
        return Random.ColorHSV(0f, 1f, 0.8f, 1f, 0.8f, 1f);
    }

    private void SetSphereColor(Color color)
    {
        if (meshRenderer == null) return;

        Material mat = meshRenderer.material;
        mat.color = color;

        if (mat.HasProperty("_BaseColor"))
        {
            mat.SetColor("_BaseColor", color);
        }
    }

    private void AnimatePulse()
    {
        if (_pulseTimer > 0f)
        {
            _pulseTimer -= Time.deltaTime * 5f;
            float scaleMultiplier = 1f + (Mathf.Sin(_pulseTimer * Mathf.PI) * 0.25f);
            myTransform.localScale = _originalScale * scaleMultiplier;
        }
        else if (myTransform.localScale != _originalScale)
        {
            myTransform.localScale = _originalScale;
        }
    }
}
