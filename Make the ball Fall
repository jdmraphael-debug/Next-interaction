using UnityEngine;

[RequireComponent(typeof(MeshRenderer), typeof(Collider), typeof(Rigidbody))]
public class Shooter : MonoBehaviour
{
    private Vector3 _originalScale;
    private float _pulseTimer;

    // Drop and Circular Oscillation variables
    private bool _hasLanded;
    private Vector3 _centerPosition;
    private float _angle;

    [SerializeField] private float hoverHeight = 0.5f;       // Distance above ground to hover
    [SerializeField] private float circleRadius = 1.5f;     // Radius of the circular path
    [SerializeField] private float circleSpeed = 2.0f;      // Rotation speed in radians per second

    [SerializeField] private Transform myTransform;
    [SerializeField] private MeshRenderer meshRenderer;
    [SerializeField] private Rigidbody rb;

    void Start()
    {
        Debug.Log("Shooter script started!");

        if (myTransform == null)
            myTransform = transform;

        if (meshRenderer == null)
            meshRenderer = GetComponent<MeshRenderer>();

        if (rb == null)
            rb = GetComponent<Rigidbody>();

        // Enable physics gravity initially so the sphere drops to the floor
        rb.useGravity = true;
        rb.isKinematic = false;

        _originalScale = myTransform.localScale;

        // Set initial random color
        SetSphereColor(GetRandomVibrantColor());
    }

    void Update()
    {
        // Smoothly animate the scale pulse over time
        AnimatePulse();
    }

    void FixedUpdate()
    { 
        // Once landed, continuously move in a circular orbit around the landing point
        if (_hasLanded)
        {
            // Advance the angle over time
            _angle += circleSpeed * Time.fixedDeltaTime;

            // Calculate X and Z offsets using cosine and sine for a smooth circle
            float x = Mathf.Cos(_angle) * circleRadius;
            float z = Mathf.Sin(_angle) * circleRadius;

            // Target position maintains the hover height above the base layer
            Vector3 targetPos = _centerPosition + new Vector3(x, hoverHeight, z);
            
            // Move via Rigidbody so the collider stays perfectly in sync with the mesh
            rb.MovePosition(targetPos);
        }
    } 

    // Detects when the sphere hits the floor/base layer
    private void OnCollisionEnter(Collision collision)
    {
        if (!_hasLanded)
        {
            _hasLanded = true;

            // Switch to Kinematic mode so gravity no longer pulls it down
            rb.useGravity = false;
            rb.isKinematic = true;

            // Save the ground collision point as the center of the circle
            _centerPosition = rb.position;

            Debug.Log("Landed on base layer! Starting circular oscillation.");
        }
    }

    private void OnMouseDown()
    {
        // 1. Assign a new random color
        SetSphereColor(GetRandomVibrantColor());

        // 2. Trigger the pulse squish animation
        _pulseTimer = 1f;

        Debug.Log("Clicked! Sphere updated with new random color and pulse effect.");
    }

    private Color GetRandomVibrantColor()
    {
        return Random.ColorHSV(0f, 1f, 0.8f, 1f, 0.8f, 1f);
    }

    private void SetSphereColor(Color color)
    {
        if (meshRenderer == null) return;

        Material mat = meshRenderer.material;
        mat.color = color;

        if (mat.HasProperty("_BaseColor"))
        {
            mat.SetColor("_BaseColor", color);
        }
    }

    private void AnimatePulse()
    {
        if (_pulseTimer > 0f)
        {
            _pulseTimer -= Time.deltaTime * 5f;
            float scaleMultiplier = 1f + (Mathf.Sin(_pulseTimer * Mathf.PI) * 0.25f);
            myTransform.localScale = _originalScale * scaleMultiplier;
        }
        else if (myTransform.localScale != _originalScale)
        {
            myTransform.localScale = _originalScale;
        }
    }
}
